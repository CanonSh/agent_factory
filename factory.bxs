// Flujo local: especificacion -> generacion -> validacion -> evaluacion.
try {
    root = getDirectoryFromPath( getCurrentTemplatePath() );
    generator = new lib.Generator( root );

    console = createObject( "java", "ortus.boxlang.runtime.cli.MiniConsole" ).init( "" );
    println( "Nombre del agente (letras, numeros, - o _; debe iniciar con letra):" );
    requestedName = trim( console.readLine() ?: "" );
    if ( !reFind( "^[A-Za-z][A-Za-z0-9_-]{0,49}$", requestedName ) ) {
        throw( type: "InvalidAgentName", message: "El nombre debe iniciar con una letra y contener solo letras, numeros, guion o guion bajo (maximo 50 caracteres)." );
    }

    println( "Describe en lenguaje natural que debe hacer el agente:" );
    instruction = trim( console.readLine() ?: "" );
    if ( !len( instruction ) ) {
        throw( type: "MissingAgentInstruction", message: "La instruccion del agente no puede estar vacia." );
    }

    analyst = new lib.Analyst();
    spec = analyst.analyze( instruction, requestedName );
    generatedPath = generator.generate( spec );
    println( "AGENTE CREADO DESDE LA INSTRUCCION: " & generatedPath );

    validation = new lib.Validator().validate( generatedPath );
    evaluation = new lib.Evaluator().evaluate( validation );

    println( "AGENTE GENERADO: " & generatedPath );
    println( "VALIDACION: " & jsonSerialize( validation ) );
    println( "EVALUACION: " & jsonSerialize( evaluation ) );
} catch ( any error ) {
    println( "ERROR DEL FACTORY: " & error.message );
    if ( error.keyExists( "detail" ) && len( error.detail & "" ) ) {
        println( error.detail );
    }
}
